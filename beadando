using System;
using System.Collections.Generic;
using System.IO;

namespace CsaladiNaptar
{
    class Esemeny
    {
        public string Tulajdonos;
        public DateTime Idopont;
        public TimeSpan Idotartam;
        public bool IsUj;

        public Esemeny(string tulajdonos, DateTime idopont, TimeSpan idotartam, bool isUj)
        {
            this.Tulajdonos = tulajdonos.ToLower();
            this.Idopont = idopont;
            this.Idotartam = idotartam;
            this.IsUj = isUj;
        }

        public DateTime GetVegIdopont()
        {
            return Idopont.Add(Idotartam);
        }

        public override string ToString()
        {
            return Idopont.ToString("yyyy.MM.dd HH:mm") + " - " + GetVegIdopont().ToString("HH:mm") + " | " + Tulajdonos + " (" + Idotartam.TotalMinutes + " perc)";
        }
    }
  class Program
  {
      static List<Esemeny> esemenyek = new List<Esemeny>();
      static Random rnd = new Random();

      static void Main(string[] args)
      {
          KezdetiFeltoltes();

          bool fut = true;
          while (fut)
          {
              Console.ResetColor();
              Console.Clear();
              Console.WriteLine("2028 FEBRUAR - CSALADI NAPTAR");
              Console.WriteLine("1. Naptar megjelenitese");
              Console.WriteLine("2. Uj esemeny rogzitese");
              Console.WriteLine("3. Legkozelebbi esemeny");
              Console.WriteLine("4. Kilepes es mentes");
              Console.Write("Valassz: ");

              string v = Console.ReadLine();

              if (v == "1") Listazas();
              else if (v == "2") UjEsemeny();
              else if (v == "3") Legkozelebbi();
              else if (v == "4")
              {
                  Mentes();
                  fut = false;
              }
          }
      }
 static void KezdetiFeltoltes()
 {
     for (int i = 0; i < 40; i++)
     {
         int nap = rnd.Next(1, 30);
         int ora = rnd.Next(8, 19);
         int perc = rnd.Next(0, 4) * 15;
         DateTime start = new DateTime(2028, 2, nap, ora, perc, 0);
         TimeSpan tartam = TimeSpan.FromMinutes(rnd.Next(30, 121));
         string nev = rnd.Next(0, 2) == 0 ? "apa" : "anya";

         if (!UtkozesVan(nev, start, tartam))
         {
             esemenyek.Add(new Esemeny(nev, start, tartam, false));
         }
     }
     Rendezes();
 }
  static bool UtkozesVan(string nev, DateTime start, TimeSpan tartam)
  {
      DateTime vege = start.Add(tartam);
      string keresettNev = nev.ToLower();

      foreach (Esemeny e in esemenyek)
      {
          if (e.Tulajdonos == keresettNev)
          {
              if (start < e.GetVegIdopont() && e.Idopont < vege)
              {
                  return true;
              }
          }
      }
      return false;
  }

        static void Rendezes()
        {
            for (int i = 0; i < esemenyek.Count - 1; i++)
            {
                for (int j = i + 1; j < esemenyek.Count; j++)
                {
                    if (esemenyek[i].Idopont > esemenyek[j].Idopont)
                    {
                        Esemeny csere = esemenyek[i];
                        esemenyek[i] = esemenyek[j];
                        esemenyek[j] = csere;
                    }
                }
            }
        }
