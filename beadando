using System;
using System.Collections.Generic;
using System.IO;

namespace CsaladiNaptar
{
    class Esemeny
    {
        public string Tulajdonos;
        public DateTime Idopont;
        public TimeSpan Idotartam;
        public bool IsUj;

        public Esemeny(string tulajdonos, DateTime idopont, TimeSpan idotartam, bool isUj)
        {
            this.Tulajdonos = tulajdonos.ToLower();
            this.Idopont = idopont;
            this.Idotartam = idotartam;
            this.IsUj = isUj;
        }

        public DateTime GetVegIdopont()
        {
            return Idopont.Add(Idotartam);
        }

        public override string ToString()
        {
            return Idopont.ToString("yyyy.MM.dd HH:mm") + " - " + GetVegIdopont().ToString("HH:mm") + " | " + Tulajdonos + " (" + Idotartam.TotalMinutes + " perc)";
        }
    }
  class Program
  {
      static List<Esemeny> esemenyek = new List<Esemeny>();
      static Random rnd = new Random();

      static void Main(string[] args)
      {
          KezdetiFeltoltes();

          bool fut = true;
          while (fut)
          {
              Console.ResetColor();
              Console.Clear();
              Console.WriteLine("2028 FEBRUAR - CSALADI NAPTAR");
              Console.WriteLine("1. Naptar megjelenitese");
              Console.WriteLine("2. Uj esemeny rogzitese");
              Console.WriteLine("3. Legkozelebbi esemeny");
              Console.WriteLine("4. Kilepes es mentes");
              Console.Write("Valassz: ");

              string v = Console.ReadLine();

              if (v == "1") Listazas();
              else if (v == "2") UjEsemeny();
              else if (v == "3") Legkozelebbi();
              else if (v == "4")
              {
                  Mentes();
                  fut = false;
              }
          }
      }
 static void KezdetiFeltoltes()
 {
     for (int i = 0; i < 40; i++)
     {
         int nap = rnd.Next(1, 30);
         int ora = rnd.Next(8, 19);
         int perc = rnd.Next(0, 4) * 15;
         DateTime start = new DateTime(2028, 2, nap, ora, perc, 0);
         TimeSpan tartam = TimeSpan.FromMinutes(rnd.Next(30, 121));
         string nev = rnd.Next(0, 2) == 0 ? "apa" : "anya";

         if (!UtkozesVan(nev, start, tartam))
         {
             esemenyek.Add(new Esemeny(nev, start, tartam, false));
         }
     }
     Rendezes();
 }
  static bool UtkozesVan(string nev, DateTime start, TimeSpan tartam)
  {
      DateTime vege = start.Add(tartam);
      string keresettNev = nev.ToLower();

      foreach (Esemeny e in esemenyek)
      {
          if (e.Tulajdonos == keresettNev)
          {
              if (start < e.GetVegIdopont() && e.Idopont < vege)
              {
                  return true;
              }
          }
      }
      return false;
  }

        static void Rendezes()
        {
            for (int i = 0; i < esemenyek.Count - 1; i++)
            {
                for (int j = i + 1; j < esemenyek.Count; j++)
                {
                    if (esemenyek[i].Idopont > esemenyek[j].Idopont)
                    {
                        Esemeny csere = esemenyek[i];
                        esemenyek[i] = esemenyek[j];
                        esemenyek[j] = csere;
                    }
                }
            }
        }

        static void Listazas()
        {
            Console.Clear();
            foreach (Esemeny e in esemenyek)
            {
                if (e.IsUj) Console.ForegroundColor = ConsoleColor.Green;
                else Console.ResetColor();
                Console.WriteLine(e.ToString());
            }
            Console.ResetColor();
            Console.WriteLine("\nNyomj entert...");
            Console.ReadLine();
        }
   static void UjEsemeny()
   {
       Console.Clear();
       Console.Write("Tulajdonos (apa/anya): ");
       string nev = Console.ReadLine();
       Console.Write("Nap (1-29): ");
       int nap = int.Parse(Console.ReadLine());
       Console.Write("Ora: ");
       int ora = int.Parse(Console.ReadLine());
       Console.Write("Perc: ");
       int perc = int.Parse(Console.ReadLine());
       Console.Write("Idotartam (perc): ");
       int percTartam = int.Parse(Console.ReadLine());

       DateTime start = new DateTime(2028, 2, nap, ora, perc, 0);
       TimeSpan tartam = TimeSpan.FromMinutes(percTartam);

       if (start.Hour < 8 || start.Add(tartam) > new DateTime(2028, 2, nap, 20, 0, 0))
       {
           Console.WriteLine("Hiba: Csak 8 es 20 ora kozott lehet!");
       }
       else if (UtkozesVan(nev, start, tartam))
       {
           Console.WriteLine("Hiba: Utkozes van!");
       }
       else
       {
           esemenyek.Add(new Esemeny(nev, start, tartam, true));
           Rendezes();
           Console.WriteLine("Sikeres mentese!");
       }
       Console.ReadLine();
   }
  static void Legkozelebbi()
  {
      Console.Clear();
      DateTime refPont = new DateTime(2028, 2, rnd.Next(1, 30), rnd.Next(0, 24), rnd.Next(0, 60), 0);
      Console.WriteLine("Referencia: " + refPont.ToString());

      if (esemenyek.Count == 0) return;

      Esemeny legkozelebbi = esemenyek[0];
      long minKulonbseg = Math.Abs((esemenyek[0].Idopont - refPont).Ticks);

      for (int i = 1; i < esemenyek.Count; i++)
      {
          long aktualisKulonbseg = Math.Abs((esemenyek[i].Idopont - refPont).Ticks);
          if (aktualisKulonbseg < minKulonbseg)
          {
              minKulonbseg = aktualisKulonbseg;
              legkozelebbi = esemenyek[i];
          }
      }

      Console.WriteLine("A legkozelebbi: " + legkozelebbi.ToString());
      Console.ReadLine();
  }
